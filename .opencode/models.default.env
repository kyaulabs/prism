# $KYAULabs: models.default.env kyau@nova 2026/07/10 -0700 Exp $

# models.default.env — Default model assignments for the KYAULabs harness.
#
# These values are sourced by .envrc (direnv) on directory entry.
# Users override them via ~/.config/opencode/models.env (generated by /setup).
#
# Four tiers:
#   PRIMARY  — high-capability model for code generation (build, tdd, architect, etc.)
#   PLANNER  — reasoning-optimized model for planning (plan)
#   JUDGE    — evaluation model for read-only assessment (judge)
#   UTILITY  — cost-efficient model for routine tasks (compaction, title, summary, etc.)

export OPENCODE_MODEL_PRIMARY='deepseek/deepseek-v4-pro'
export OPENCODE_MODEL_PLANNER='openrouter/z-ai/glm-5.2'
export OPENCODE_MODEL_JUDGE='openrouter/z-ai/glm-5.2'
export OPENCODE_MODEL_UTILITY='deepseek/deepseek-v4-flash'

export OPENCODE_VARIANT_PRIMARY='max'
export OPENCODE_VARIANT_PLANNER='high'
export OPENCODE_VARIANT_JUDGE='medium'
export OPENCODE_VARIANT_UTILITY='medium'
