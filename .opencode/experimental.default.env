# $KYAULabs: experimental.default.env seanbruen@akira.kyaulabs 2026/07/16 -0700 Exp $

# experimental.default.env — OpenCode experimental process flags for the
# KYAULabs harness.
#
# Sourced by .envrc (direnv) on directory entry. These are consumed by the
# opencode TUI process before any PHP code runs — separate from the PHP-runtime
# $_ENV layer (ADR-0003). Users override via ~/.config/opencode/models.env if
# needed.
#
# See: ADR-0024 (Experimental Subagent Dependencies)

# LSP Tool — enables Intelephense lsp tool for six agents (ADR-0024)
# Previously manual shell-profile export; consolidated here for auto-sourcing.
export OPENCODE_EXPERIMENTAL_LSP_TOOL=true

# Scout — enables the built-in @scout experimental subagent (ADR-0005 delegate)
export OPENCODE_EXPERIMENTAL_SCOUT=true

# Background Subagents — gated on ADR-0024 Phase-0 spike
# export OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true
# vim: ft=sh sts=4 sw=4 ts=4 et :
