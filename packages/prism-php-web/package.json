  "prism": {
    "adapter": true,
    "toolchain": "./toolchain.json",
    "handler": "./scripts/prism-tool-adapter.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
