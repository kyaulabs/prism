{
  "name": "@kyaulabs/prism-php-web",
  "version": "0.3.0",
  "description": "KYAULabs coding harness — PHP/web stack adapter (pi)",
  "license": "AGPL-3.0-only",
  "keywords": [
    "pi-package",
    "prism-adapter"
  ],
  "files": [
    "skills",
    "prompts",
    "scripts",
    "docs",
    "toolchain.json",
    "safe-dirs.json",
    "NOTICE"
  ],
  "pi": {
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
