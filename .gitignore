# Logs
*.log

# Browser test artifacts (see pest-browser skill)
tests/Browser/Screenshots/

# Throwaway prototypes and debug harnesses (see prototype skill)
prototypes/
prototype_*

# Vestigial guard: Graphify was purged (ADR-0039) but graphify-out/ may linger
# as a local build artifact until manually deleted (rm -rf graphify-out/).
# Kept ignored so it cannot be accidentally committed; safe to remove once gone.
graphify-out/

# External audit reports (never committed; local review artifacts)
audits/
graphify-out/

# Scaffold test targets (setup-scaffold.sh containment tests — issue #193)
/.test-scaffold-tmp/

# Editor files
*.swp
*.swo
*~

# macOS/Windows files
.DS_Store
desktop.ini
Thumbs.db

