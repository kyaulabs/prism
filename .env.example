# Environment variables for <app>
# Copy to .env and fill in values. NEVER commit .env — it is gitignored.
# See AGENTS.md hard boundaries and the security-coding skill.

# Database
DB_HOST=localhost
DB_NAME=<app>
DB_USER=
DB_PASSWORD=

# Application
APP_ENV=development
APP_DEBUG=false

# Secrets (generate with: php -r "echo bin2hex(random_bytes(32));")
APP_KEY=
CSRF_KEY=
