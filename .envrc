# $KYAULabs: .envrc kyau@nova 2026/07/10 -0700 Exp $

# .envrc — direnv entry hook for the KYAULabs harness.
#
# Sources committed model defaults + experimental opencode flags, then user
# overrides (if present).
#
# Prerequisites:
#   1. Install direnv shell hook (one-time):
#      fish:  echo 'direnv hook fish | source' > ~/.config/fish/conf.d/direnv.fish
#      bash:  echo 'eval "$(direnv hook bash)"' >> ~/.bashrc
#      zsh:   echo 'eval "$(direnv hook zsh)"' >> ~/.zshrc
#   2. Restart your shell.
#   3. cd into the project and run: direnv allow
#
# Users without direnv: add 'source /path/to/repo/.envrc' to your shell profile.

# Derive directory so this file can be sourced from outside the repo
DIR="$(dirname "${BASH_SOURCE[0]:-$0}")"
source "$DIR/.opencode/models.default.env"
source "$DIR/.opencode/experimental.default.env"

# Source user overrides (generated by /setup)
if [ -f ~/.config/opencode/models.env ]; then
	source ~/.config/opencode/models.env
fi
