# $KYAULabs: .envrc kyau@nova 2026/07/19 -0700 Exp $

# .envrc — direnv entry hook for the KYAULabs harness.
#
# Sources all configuration from .opencode/setup.json (unified config per
# ADR-0029) and ~/.config/opencode/setup.json (user-level override).
#
# Prerequisites:
#   1. jq installed (apt install jq / brew install jq)
#   2. direnv shell hook (see README)
#   3. cd into project and run: direnv allow
#
# Users without direnv: add 'source /path/to/repo/.envrc' to your shell profile.

if ! command -v jq >/dev/null 2>&1; then
    echo "✗ jq is required by .envrc. Install via your package manager." >&2
    echo "  apt install jq  /  brew install jq  /  dnf install jq" >&2
    return 1 2>/dev/null || exit 1
fi

DIR="$(dirname "${BASH_SOURCE[0]:-$0}")"
PROJECT_SETUP="$DIR/.opencode/setup.json"
USER_SETUP="$HOME/.config/opencode/setup.json"
LEGACY_USER_ENV="$HOME/.config/opencode/models.env"

# Migrate v1→v4 schema only if needed (single jq probe, no subshell).
if [ -f "$PROJECT_SETUP" ] && \
   [ "$(jq -r '.setup_version // 0' "$PROJECT_SETUP" 2>/dev/null)" -lt 4 ] 2>/dev/null; then
    bash "$DIR/.github/scripts/migrate-setup.sh" "$PROJECT_SETUP" 2>/dev/null || true
fi

# Pick the setup file (user override wins over project).
SETUP_FILE=""
if [ -f "$USER_SETUP" ]; then
    SETUP_FILE="$USER_SETUP"
elif [ -f "$PROJECT_SETUP" ]; then
    SETUP_FILE="$PROJECT_SETUP"
fi

# Single jq call: emit shell-safe `VAR=value` lines for everything we need.
# Empty values fall back to the legacy ~/.config/opencode/models.env shim below.
if [ -n "$SETUP_FILE" ]; then
    eval "$(jq -r '
        "OPENCODE_MODEL_PRIMARY=\(.models.primary|@sh)",
        "OPENCODE_MODEL_PLANNER=\(.models.planner|@sh)",
        "OPENCODE_MODEL_JUDGE=\(.models.judge|@sh)",
        "OPENCODE_MODEL_UTILITY=\(.models.utility|@sh)",
        "OPENCODE_VARIANT_PRIMARY=\(.variants.primary|@sh)",
        "OPENCODE_VARIANT_PLANNER=\(.variants.planner|@sh)",
        "OPENCODE_VARIANT_JUDGE=\(.variants.judge|@sh)",
        "OPENCODE_VARIANT_UTILITY=\(.variants.utility|@sh)",
        "OPENCODE_EXPERIMENTAL_LSP_TOOL=\(.experimental.lsp_tool|@sh)",
        "OPENCODE_EXPERIMENTAL_SCOUT=\(.experimental.scout|@sh)",
        "OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=\(.experimental.background_subagents|@sh)"
    ' "$SETUP_FILE")"
    export OPENCODE_MODEL_PRIMARY OPENCODE_MODEL_PLANNER OPENCODE_MODEL_JUDGE OPENCODE_MODEL_UTILITY
    export OPENCODE_VARIANT_PRIMARY OPENCODE_VARIANT_PLANNER OPENCODE_VARIANT_JUDGE OPENCODE_VARIANT_UTILITY
    export OPENCODE_EXPERIMENTAL_LSP_TOOL OPENCODE_EXPERIMENTAL_SCOUT OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS
fi

# Back-compat shim: legacy ~/.config/opencode/models.env (pre-ADR-0029).
# Fires whenever the user hasn't migrated to ~/.config/opencode/setup.json.
# Sourced AFTER setup.json so legacy values take precedence (preserves
# original behavior — user overrides should win over project defaults).
if [ ! -f "$USER_SETUP" ] && [ -f "$LEGACY_USER_ENV" ]; then
    echo "⚠ Deprecated: ~/.config/opencode/models.env found. Migrate by running /setup." >&2
    echo "  Will be removed in a future release (ADR-0029)." >&2
    # shellcheck disable=SC1090  # path is user-controlled, can't be made constant
    source "$LEGACY_USER_ENV"
fi

# vim: ft=sh sts=4 sw=4 ts=4 et :
