# $KYAULabs: .envrc kyau@nova 2026/07/19 -0700 Exp $

# .envrc — direnv entry hook for the KYAULabs harness.
#
# Sources configuration from the layered prism.jsonc manifest (ADR-0043):
# the project tier at $DIR/prism.jsonc overlaid field-by-field by the
# optional user tier at ~/.config/opencode/prism.jsonc. The twenty
# OPENCODE_*/secret environment variables (including three request-preference
# toggle diagnostics and the composed OPENCODE_CONFIG_CONTENT) are produced
# by the dependency-free prism_manifest.php env0 CLI as a NUL-separated
# stream — no jq, no eval, no shell expansion of manifest values.
#
# Prerequisites:
#   1. PHP 8.5+ on PATH (apt install php-cli / brew install php)
#   2. direnv shell hook (see README)
#   3. cd into project and run: direnv allow
#
# Users without direnv: add 'source /path/to/repo/.envrc' to your shell profile.

if ! command -v php >/dev/null 2>&1; then
    echo "✗ php is required by .envrc. Install via your package manager." >&2
    echo "  apt install php-cli  /  brew install php  /  dnf install php" >&2
    return 1 2>/dev/null || exit 1
fi

DIR="$(dirname "${BASH_SOURCE[0]:-$0}")"
PROJECT_MANIFEST="$DIR/prism.jsonc"
USER_MANIFEST="$HOME/.config/opencode/prism.jsonc"
LEGACY_USER_SETUP="$HOME/.config/opencode/setup.json"

# Reject legacy-only project state: a project without a prism.jsonc has not
# been migrated to the v5 manifest. Fail closed with a pointer to /setup
# rather than silently exporting nothing (or reading a legacy setup.json).
if [ ! -f "$PROJECT_MANIFEST" ]; then
    echo "✗ Project manifest not found: $PROJECT_MANIFEST" >&2
    echo "  Run /setup to generate prism.jsonc." >&2
    return 1 2>/dev/null || exit 1
fi

# Warn + ignore legacy user setup.json. The v5 user tier is prism.jsonc; a
# residual setup.json is not read, only flagged for /setup migration.
if [ -f "$LEGACY_USER_SETUP" ]; then
    echo "⚠ Deprecated: $LEGACY_USER_SETUP found (ignored)." >&2
    echo "  Migrate by running /setup; the v5 user manifest is prism.jsonc." >&2
fi

# Load the resolved manifest via the dependency-free PHP CLI. Output is fully
# buffered into a temp file and the exit status checked BEFORE any byte is
# consumed, so a malformed manifest exports nothing. umask 077 keeps the temp
# file (which may carry user secrets) readable only by its owner; it is saved
# and restored so direnv's frequent re-sourcing never changes the caller umask.
_PRISM_OLD_UMASK=$(umask)
umask 077
_TMPFILE="$(mktemp 2>/dev/null || mktemp -t prismenv)"

# Build the CLI argv: always the project manifest, plus the user manifest
# only when its file actually exists (otherwise the CLI would try to read a
# missing file and fail closed).
_PRISM_ARGS=("$DIR/.github/scripts/prism_manifest.php" env0 "$PROJECT_MANIFEST")
if [ -f "$USER_MANIFEST" ]; then
    _PRISM_ARGS+=("$USER_MANIFEST")
fi

if php "${_PRISM_ARGS[@]}" > "$_TMPFILE"; then
    # Paired NUL-delimited reads: name, then value, repeat. No field is ever
    # passed through eval, so metacharacters in values are exported literally.
    while IFS= read -r -d '' _name && IFS= read -r -d '' _value; do
        export "$_name=$_value"
    done < "$_TMPFILE"
    _PRISM_RC=0
else
    _PRISM_RC=1
fi

rm -f "$_TMPFILE"
umask "$_PRISM_OLD_UMASK"

if [ "$_PRISM_RC" -ne 0 ]; then
    echo "✗ Failed to load prism manifest (see error above). Run /setup to reconfigure." >&2
    return 1 2>/dev/null || exit 1
fi

# vim: ft=sh sts=4 sw=4 ts=4 et :
