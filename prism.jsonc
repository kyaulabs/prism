// $KYAULabs: prism.jsonc kyau@cosmos.kyaulabs 2026/07/29 -0700 Exp $

// Prism project manifest — schema v6 (ADR-0043, ADR-0049).
//
// This is the PROJECT tier of the layered manifest. It carries the shipped
// defaults committed to the repo. The USER tier lives at
// ~/.config/opencode/prism.jsonc and overlays this file field-by-field (object
// keys merge recursively; scalars/arrays replace atomically).
//
// .envrc consumes this via `prism_manifest.php env0`, which exports twenty-two
// OPENCODE_*/secret environment variables as a NUL-separated stream (including
// three requested-preference toggle diagnostics and composed
// OPENCODE_CONFIG_CONTENT — no jq, no eval). Secrets never live here: the
// env.* section must stay empty in the project manifest; user secrets belong
// in the user manifest.
//
// Optional integration preferences (mcp.*, plugins.*) are resolved from this
// file and the user manifest, composed into OPENCODE_CONFIG_CONTENT at env0
// time. Each preference is tracked as false here; enablement is a user choice
// via /setup (see ADR-0045).
{
  // Schema version — must be exactly 6. Bumped by migrations only.
  "setup_version": 6,

  // Whether /setup has run at least once for this project.
  "configured": true,

  // ISO-8601 timestamp of the last /setup write.
  "timestamp": "2026-07-06T23:44:00Z",

  // Project identity — wired into the harness (<app>.<domain>, git remotes).
  "app": "prism",
  "domain": "kyaulabs",
  "repo": "kyaulabs/prism",

  // Signed-off-by identity resolved by resolve-identity.sh (3-tier fallback).
  "signed_off_by_name": "kyau",
  "signed_off_by_email": "git@kyaulabs.com",

  // Visual accent theme consumed by the frontend tokens (sky-blue | light-purple).
  "accent": "sky-blue",

  // Scaffold behavior for derived projects (skip | clone | new).
  "scaffold_mode": "skip",

  // Optional override folder for scaffold output; null means "not set".
  "project_folder": null,

  // Six-tier model map. Each value is a provider/model-id consumed via
  // {env:OPENCODE_MODEL_<TIER>} substitution in opencode.jsonc.
  "models": {
    "primary": "zai-coding-plan/glm-5.2",
    "planner": "openai/gpt-5.6-sol",
    "design": "openai/gpt-5.6-sol",
    "frontend": "openai/gpt-5.6-sol",
    "judge": "deepseek/deepseek-v4-pro",
    "utility": "deepseek/deepseek-v4-flash"
  },

  // Six-tier variant map (reasoning effort). Consumed via
  // {env:OPENCODE_VARIANT_<TIER>} substitution.
  "variants": {
    "primary": "max",
    "planner": "xhigh",
    "design": "xhigh",
    "frontend": "xhigh",
    "judge": "medium",
    "utility": "medium"
  },

  // Experimental opencode feature flags, exported as OPENCODE_EXPERIMENTAL_*.
  "experimental": {
    "lsp_tool": true,
    "scout": true,
    "background_subagents": false
  },

  // Optional MCP preferences. Effective enablement also requires the matching
  // non-empty env value from the resolved user manifest.
  "mcp": {
    "deepseek_websearch": false,
    "searxng": false
  },

  // Optional npm plugin preferences. Packages stay pinned even while disabled.
  "plugins": {
    "opencode_quota": false
  },

  // Sensitive-path extension surface (ADR-0047), exported as newline-joined
  // OPENCODE_SENSITIVE_PATHS. Malformed values fail closed at env0 time.
  "security": {
    // Immutable deny floor lives in .opencode/plugins/sensitive-paths.ts (ADR-0047).
    // This list can only ADD paths; entries must be "~/"-prefixed or absolute.
    "additional_sensitive_paths": []
  },

  // Secret home for the project tier. SECURITY INVARIANT: every value here
  // MUST be empty. Non-empty values fail validateProject()/check-secrets and
  // block .envrc. Real secrets live in the user manifest only.
  "env": {
    "deepseek_api_key": "",
    "searxng_url": ""
  }
}
