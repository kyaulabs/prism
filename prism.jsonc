// $KYAULabs: prism.jsonc kyau@cosmos.kyaulabs 2026/07/29 -0700 Exp $

// Prism project manifest — schema v5 (ADR-0043).
//
// This is the PROJECT tier of the layered manifest. It carries the shipped
// defaults committed to the repo. The USER tier lives at
// ~/.config/opencode/prism.jsonc and overlays this file field-by-field (object
// keys merge recursively; scalars/arrays replace atomically).
//
// .envrc consumes this via `prism_manifest.php env0`, which exports the
// fifteen OPENCODE_*/secret environment variables as a NUL-separated stream
// (no jq, no eval). Secrets never live here: the env.* section must stay
// empty in the project manifest; user secrets belong in the user manifest.
{
  // Schema version — must be exactly 5. Bumped by migrations only.
  "setup_version": 5,

  // Whether /setup has run at least once for this project.
  "configured": true,

  // ISO-8601 timestamp of the last /setup write.
  "timestamp": "2026-07-06T23:44:00Z",

  // Project identity — wired into the harness (<app>.<domain>, git remotes).
  "app": "prism",
  "domain": "kyaulabs",
  "repo": "kyaulabs/prism",

  // Signed-off-by identity resolved by resolve-identity.sh (3-tier fallback).
  "signed_off_by_name": "kyau",
  "signed_off_by_email": "git@kyaulabs.com",

  // Visual accent theme consumed by the frontend tokens (sky-blue | light-purple).
  "accent": "sky-blue",

  // Scaffold behavior for derived projects (skip | clone | new).
  "scaffold_mode": "skip",

  // Optional override folder for scaffold output; null means "not set".
  "project_folder": null,

  // Five-tier model map. Each value is a provider/model-id consumed via
  // {env:OPENCODE_MODEL_<TIER>} substitution in opencode.jsonc.
  "models": {
    "primary": "zai-coding-plan/glm-5.2",
    "planner": "openai/gpt-5.6-sol",
    "design": "openai/gpt-5.6-sol",
    "judge": "deepseek/deepseek-v4-pro",
    "utility": "deepseek/deepseek-v4-flash"
  },

  // Five-tier variant map (reasoning effort). Consumed via
  // {env:OPENCODE_VARIANT_<TIER>} substitution.
  "variants": {
    "primary": "max",
    "planner": "xhigh",
    "design": "xhigh",
    "judge": "medium",
    "utility": "medium"
  },

  // Experimental opencode feature flags, exported as OPENCODE_EXPERIMENTAL_*.
  "experimental": {
    "lsp_tool": true,
    "scout": true,
    "background_subagents": false
  },

  // Secret home for the project tier. SECURITY INVARIANT: every value here
  // MUST be empty. Non-empty values fail validateProject()/check-secrets and
  // block .envrc. Real secrets live in the user manifest only.
  "env": {
    "deepseek_api_key": "",
    "searxng_url": ""
  }
}
