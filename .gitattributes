# Ensure consistent line endings
* text=auto eol=lf
*.md text

# Treat binary files properly
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary

# Mark generated files
cdn/css/**/*.min.css linguist-generated
cdn/javascript/**/*.min.js linguist-generated

# Reduce lockfile diff noise
composer.lock -diff
package-lock.json -diff
