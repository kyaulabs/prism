#!/usr/bin/env bash
# $KYAULabs: pre-push kyau@nova 2026/07/04 -0700 Exp $

set -euo pipefail

RED=$'\033[1;31m'
YELLOW=$'\033[1;33m'
ORANGE=$'\033[38;5;208m'
DIM=$'\033[2m'
BOLD=$'\033[1m'
CYAN=$'\033[36m'
RESET=$'\033[0m'

# Returns 0 (true) if $1 is empty or all zeros (deletion or new ref).
# Works with both SHA-1 (40 zeros) and SHA-256 (64 zeros) OIDs.
is_zero_oid() {
	case "$1" in
		*[!0]*) return 1 ;;
		*) return 0 ;;
	esac
}

# Returns 0 (true) only when the remote OID is zero AND the local push
# is a single zero-parent root commit — the initial seed push exception.
# Never treats a zero remote OID alone as sufficient.
is_initial_protected_push() {
	local local_oid="$1" remote_oid="$2"
	local count parent_count
	if ! is_zero_oid "$remote_oid"; then
		return 1
	fi
	if is_zero_oid "$local_oid"; then
		return 1
	fi
	count=$(git rev-list --count "$local_oid")
	if [ "$count" -ne 1 ]; then
		return 1
	fi
	parent_count=$(git rev-list --parents -n 1 "$local_oid" | wc -w | tr -d ' ')
	if [ "$parent_count" -ne 1 ]; then
		return 1
	fi
	return 0
}

BRANCH_COUNT=0

while read -r local_ref local_oid remote_ref remote_oid; do
	# ── Protected-ref gate ──────────────────────────────────────────────
	# Block pushes targeting protected refs except the initial seed push.
	case "$remote_ref" in
		refs/heads/main|refs/heads/develop)
			if ! is_initial_protected_push "$local_oid" "$remote_oid"; then
				branch_name="${remote_ref#refs/heads/}"
				cat >&2 <<EOF

${RED}╭─  BLOCKED  Push to ${branch_name} is prohibited${RESET}
${RED}│${RESET}
${RED}│${RESET}   Direct pushes to ${branch_name} are not allowed.${RESET}
${RED}│${RESET}   All integration to ${branch_name} must go through a pull request.${RESET}
${RED}│${RESET}
${RED}╰──────────────────────────────────────────────────────────────────╯${RESET}

EOF
				exit 1
			fi
			;;
	esac

	# Skip tag pushes — tags are not branches and should not trigger
	# history-protection or no-squash checks.
	case "$remote_ref" in
		refs/tags/*) continue ;;
	esac

	# Skip branch deletions (zero or empty local OID).
	if is_zero_oid "$local_oid"; then
		continue
	fi
	BRANCH_COUNT=$((BRANCH_COUNT + 1))

	# ── Non-fast-forward check (hard gate) ─────────────────────────────────
	# Block pushes that would rewrite published history. amend, rebase, or
	# reset on a pushed commit triggers this — fix local history before pushing.
	if [ -n "$remote_oid" ] && ! is_zero_oid "$remote_oid"; then
		# git merge-base exits 0 if remote_oid is an ancestor of local_oid
		# (fast-forward). We run it inside an if to avoid triggering set -e.
		set +e
		git merge-base --is-ancestor "$remote_oid" "$local_oid" 2>/dev/null
		ancestor_rc=$?
		set -e
		if [ "$ancestor_rc" -ne 0 ]; then
			branch_name="${local_ref#refs/heads/}"
			cat >&2 <<EOF

${RED}╭─  BLOCKED  Non-fast-forward push to ${branch_name}${RESET}
${RED}│${RESET}
${RED}│${RESET}   Rewriting published history is prohibited.${RESET}
${RED}│${RESET}   The remote has commits that would be overwritten.${RESET}
${RED}│${RESET}
${RED}│${RESET}   This can happen if a pushed commit was amended, rebased,${RESET}
${RED}│${RESET}   or reset. Fix your local history before pushing.${RESET}
${RED}│${RESET}
${RED}╰──────────────────────────────────────────────────────────────────╯${RESET}

EOF
			exit 1
		fi
	fi

	# ── No-squash check (soft gate) ───────────────────────────────────────
	# Warn if pushing a single-commit branch that looks like a squash.
	# The push proceeds, but the warning is prominent.
	# Only applies to new branches — the non-fast-forward gate above
	# already blocks force-pushes, so existing branches are always
	# fast-forward (incremental) pushes here.
	if [ -z "$remote_oid" ] || is_zero_oid "$remote_oid"; then
		count=$(git rev-list --count "$local_oid" --not --remotes 2>/dev/null || echo 0)
	else
		count=0
	fi

	if [ "$count" -eq 1 ]; then
		commit_msg=$(git log -1 --format=%s "$local_oid" | tr -d '\000-\037')
		cat >&2 <<EOF

${YELLOW}╭─  WARNING  Single-commit push detected ─────────────────────────╮${RESET}
${YELLOW}│${RESET}
${YELLOW}│${RESET}   This branch has only 1 commit:
${YELLOW}│${RESET}      ${DIM}${ORANGE}${RESET} ${BOLD}${commit_msg}${RESET}
${YELLOW}│${RESET}
${YELLOW}│${RESET}   If this is the result of a squash, consider pushing the
${YELLOW}│${RESET}   unsquashed history instead. The git history serves as the
${YELLOW}│${RESET}   development and evaluation log — squashing destroys the
${YELLOW}│${RESET}   record of what was tried, abandoned, and why.
${YELLOW}│${RESET}
${YELLOW}│${RESET}   ${CYAN}${RESET} See ${BOLD}AGENTS.md${RESET} ${CYAN}${RESET} Git Workflow ${DIM}${RESET} no-squash policy
${YELLOW}╰──────────────────────────────────────────────────────────────────╯${RESET}

EOF
	fi
done

if [ "$BRANCH_COUNT" -ge 1 ] && [ -x .github/scripts/validate-harness.sh ]; then
	# ── CI-parity gate (validate-harness) ────────────────────────────────
	# Run validate-harness.sh BEFORE the push leaves the machine. The
	# script-existence guard above skips this entire block in test repos
	# and minimal checkouts. See ADR-0025.
	echo "→ pre-push CI-parity gate (validate-harness)"
	HLOG=$(mktemp)
	if ! bash .github/scripts/validate-harness.sh >"$HLOG" 2>&1; then
		cat "$HLOG" >&2
		echo "✗ pre-push: harness validation failed. Fix locally and re-commit before pushing." >&2
		rm -f "$HLOG"
		exit 1
	fi
	rm -f "$HLOG"
	# ── shellcheck (CI parity) ────────────────────────────────────────────
	# Same scan CI runs, at CI's default severity (warning+). Fail on
	# non-empty output — also gated by the harness-script check above.
	if command -v shellcheck > /dev/null 2>&1; then
		echo "→ shellcheck (CI parity)"
		SH_OUT=$(find . -type f \( -name '*.sh' -o -path './.github/hooks/*' \) \
			-not -path './vendor/*' -not -path '*/node_modules/*' -not -path './aurora/*' \
			-print0 | xargs -0 shellcheck --severity=warning 2>&1 || true)
		if [ -n "$SH_OUT" ]; then
			printf '%s\n' "$SH_OUT" >&2
			echo "✗ pre-push: shellcheck found issues." >&2
			exit 1
		fi
	fi
fi

exit 0

# vim: ft=sh sts=4 sw=4 ts=4 et :
