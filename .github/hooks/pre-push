#!/usr/bin/env bash
# $KYAULabs: pre-push kyau@nova 2026/07/04 -0700 Exp $

set -euo pipefail

YELLOW=$'\033[1;33m'
ORANGE=$'\033[38;5;208m'
DIM=$'\033[2m'
BOLD=$'\033[1m'
CYAN=$'\033[36m'
RESET=$'\033[0m'

# ── No-squash check ──────────────────────────────────────────────────────────
# Warn if pushing a single-commit branch that looks like a squash.
# This is a soft gate — the push proceeds, but the warning is prominent.
# The git history serves as the development and evaluation log; squashing
# destroys the record of what was tried and abandoned.

remote="$1"
remote_url="$2"

while read -r local_ref local_oid remote_ref remote_oid; do
	# Skip tag pushes and branch deletions
	if [ -z "$local_oid" ] || [ "$local_oid" = "0000000000000000000000000000000000000000" ]; then
		continue
	fi

	# Compute the range: commits not yet on the remote
	range=""
	if [ -n "$remote_oid" ] && [ "$remote_oid" != "0000000000000000000000000000000000000000" ]; then
		range="${remote_oid}..${local_oid}"
	else
		range="$local_oid"
	fi

	count=$(git rev-list --count "$range" 2>/dev/null || echo 0)

	if [ "$count" -eq 1 ]; then
		commit_msg=$(git log -1 --format=%s "$local_oid")
		cat >&2 <<EOF

${YELLOW}╭─  WARNING  Single-commit push detected ─────────────────────────╮${RESET}
${YELLOW}│${RESET}
${YELLOW}│${RESET}   This branch has only 1 commit:
${YELLOW}│${RESET}      ${DIM}${ORANGE}${RESET} ${BOLD}${commit_msg}${RESET}
${YELLOW}│${RESET}
${YELLOW}│${RESET}   If this is the result of a squash, consider pushing the
${YELLOW}│${RESET}   unsquashed history instead. The git history serves as the
${YELLOW}│${RESET}   development and evaluation log — squashing destroys the
${YELLOW}│${RESET}   record of what was tried, abandoned, and why.
${YELLOW}│${RESET}
${YELLOW}│${RESET}   ${CYAN}${RESET} See ${BOLD}AGENTS.md${RESET} ${CYAN}${RESET} Git Workflow ${DIM}${RESET} no-squash policy
${YELLOW}╰──────────────────────────────────────────────────────────────────╯${RESET}

EOF
	fi
done

exit 0

# vim: ft=sh sts=4 sw=4 ts=4 et :
