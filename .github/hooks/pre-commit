#!/usr/bin/env bash
# $KYAULabs: pre-commit kyau@nova 2026/07/06 -0700 Exp $

set -euo pipefail

# ── PHP syntax check (staged files only) ─────────────────────────────────────
if command -v php > /dev/null 2>&1; then
	STAGED_PHP=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.php$' || true)
	if [ -n "$STAGED_PHP" ]; then
		echo "→ PHP syntax check"
		while IFS= read -r f; do
			php -l "$f"
		done <<< "$STAGED_PHP"
	fi
fi

# ── php-cs-fixer (staged files only) ─────────────────────────────────────────
CS_FIXER=""
if [ -x vendor/bin/php-cs-fixer ]; then
	CS_FIXER=vendor/bin/php-cs-fixer
elif command -v php-cs-fixer > /dev/null 2>&1; then
	CS_FIXER=php-cs-fixer
fi
if [ -n "$CS_FIXER" ]; then
	# Only scan staged PHP files, excluding third-party directories
	STAGED_PHP=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.php$' | grep -vE '^(vendor/|node_modules/|aurora/)' || true)
	if [ -n "$STAGED_PHP" ]; then
		echo "→ php-cs-fixer"
		CS_CONFIG=""
		if [ -f .php-cs-fixer.dist.php ]; then
			CS_CONFIG=.php-cs-fixer.dist.php
		elif [ -f .php-cs-fixer.php ]; then
			CS_CONFIG=.php-cs-fixer.php
		fi
		# --path-mode=override: scan ONLY the explicitly-passed paths,
		# ignoring the Finder scope entirely (prevents node_modules leakage)
		mapfile -t PATHS <<< "$STAGED_PHP"
		if [ -n "$CS_CONFIG" ]; then
			"$CS_FIXER" fix --config="$CS_CONFIG" --dry-run --diff --path-mode=override "${PATHS[@]}" 2>&1
		else
			"$CS_FIXER" fix --dry-run --diff --path-mode=override "${PATHS[@]}" 2>&1
		fi
	fi
fi

# ── Stylelint (staged files only) ─────────────────────────────────────────────
STAGED_SCSS=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.scss$' || true)
if [ -n "$STAGED_SCSS" ] && [ -d node_modules/stylelint ]; then
	echo "→ Stylelint"
	mapfile -t SCSS_FILES <<< "$STAGED_SCSS"
	npx stylelint "${SCSS_FILES[@]}"
fi

# ── ESLint (staged files only) ────────────────────────────────────────────────
STAGED_JS=$(git diff --cached --name-only --diff-filter=ACMR | grep '^cdn/js/.*\.js$' | grep -v '\.min\.js$' || true)
if [ -n "$STAGED_JS" ] && [ -d node_modules/eslint ]; then
	echo "→ ESLint"
	mapfile -t JS_FILES <<< "$STAGED_JS"
	npx eslint "${JS_FILES[@]}" --no-error-on-unmatched-pattern
fi

# ── Shellcheck (staged shell scripts only) ──────────────────────────────────
STAGED_SH=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.sh$|^\.github/hooks/' || true)
if [ -n "$STAGED_SH" ]; then
	if command -v shellcheck > /dev/null 2>&1; then
		echo "→ Shellcheck"
		mapfile -t SH_FILES <<< "$STAGED_SH"
		shellcheck "${SH_FILES[@]}"
	else
		echo "⚠ shellcheck not installed — skipping (apt install shellcheck / brew install shellcheck)"
	fi
fi

# ── Gitleaks ──────────────────────────────────────────────────────────────────
if command -v gitleaks > /dev/null 2>&1; then
	echo "→ gitleaks"
	# gitleaks v8+ uses 'detect'; v7 and earlier use 'protect'
	# v8+ removed --staged; pipe staged diff via --pipe instead
	if gitleaks detect --help > /dev/null 2>&1; then
		git diff --cached | gitleaks detect --pipe --redact --no-color --max-target-megabytes 5
	else
		gitleaks protect --staged --redact --no-color --max-target-megabytes 5
	fi
fi

# ── RCS header auto-add (staged source files missing a header) ─────────────────
STAGED_SRC=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(php|js|scss|sh)$' || true)
STAGED_SRC=$(echo "$STAGED_SRC" | grep -vE '^(vendor/|node_modules/|aurora/|\.opencode/|cdn/css/|cdn/javascript/)' || true)
if [ -n "$STAGED_SRC" ]; then
	CREATOR=$(git config user.email 2>/dev/null | cut -d@ -f1)
	[ -z "$CREATOR" ] && CREATOR=$(git config user.name 2>/dev/null | tr -d ' ' 2>/dev/null || echo "unknown")
	HOSTNAME=$(hostname 2>/dev/null | tr '[:upper:]' '[:lower:]')
	[ -z "$HOSTNAME" ] && HOSTNAME="unknown"
	DATESTR=$(date '+%Y/%m/%d %z')

	while IFS= read -r file; do
		[ -z "$file" ] && continue

		# Already has an RCS header?
		# shellcheck disable=SC2016  # $KYAULabs is a literal RCS marker, not a variable
		if git show ":$file" 2>/dev/null | head -10 | grep -qF '$KYAULabs:'; then
			continue
		fi

		FNAME=$(basename "$file")
		EXT="${file##*.}"

		# Determine comment syntax and header line
		case "$EXT" in
			php)   HDR="# \$KYAULabs: $FNAME $CREATOR@$HOSTNAME $DATESTR Exp \$" ;;
			scss)  HDR="// \$KYAULabs: $FNAME $CREATOR@$HOSTNAME $DATESTR Exp \$" ;;
			js)    HDR="// \$KYAULabs: $FNAME $CREATOR@$HOSTNAME $DATESTR Exp \$" ;;
			sh)    HDR="# \$KYAULabs: $FNAME $CREATOR@$HOSTNAME $DATESTR Exp \$" ;;
		esac

		# Determine vim modeline
		case "$EXT" in
			php)   ML="// vim: ft=php sts=4 sw=4 ts=4 et :" ;;
			scss)  ML="// vim: ft=scss sts=2 sw=2 ts=2 et :" ;;
			js)    ML="// vim: ft=javascript sts=4 sw=4 ts=4 noet :" ;;
			sh)    ML="# vim: ft=sh sts=4 sw=4 ts=4 et :" ;;
		esac

		# Extract staged content
		TMP=$(mktemp)
		git show ":$file" > "$TMP" 2>/dev/null || { rm -f "$TMP"; continue; }

		# Insert header and modeline
		{
			if [ "$EXT" = "php" ]; then
				# PHP: insert after <?php and optional declare(strict_types=1);
				head -1 "$TMP"
				sed -n '2p' "$TMP" | grep -q 'declare(strict_types=1);' && sed -n '2p' "$TMP"
				echo ""
				echo "$HDR"
				echo ""
				tail -n +2 "$TMP" | sed '1{/declare(strict_types=1);/d}'
			elif [ "$EXT" = "sh" ]; then
				LINE1=$(head -1 "$TMP")
				if echo "$LINE1" | grep -q '^#!/'; then
					echo "$LINE1"
					echo "$HDR"
					echo ""
					tail -n +2 "$TMP"
				else
					echo "$HDR"
					echo ""
					cat "$TMP"
				fi
			else
				echo "$HDR"
				echo ""
				cat "$TMP"
			fi
			echo ""
			echo "$ML"
		} > "$TMP.mod"

		# Write to working tree and re-stage
		cp "$TMP.mod" "$file"
		git add "$file"
		echo "  + RCS header added: $file"

		rm -f "$TMP" "$TMP.mod"
	done <<< "$STAGED_SRC"
fi

echo "✓ pre-commit passed"

# vim: ft=sh sts=4 sw=4 ts=4 et :
