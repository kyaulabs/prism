#!/usr/bin/env bash
# $KYAULabs: pre-commit kyau@nova 2026/07/06 -0700 Exp $

set -euo pipefail

# Require bash >= 3.2 (macOS ships 3.2; avoids silent misbehaviour on sh/dash)
if [ "${BASH_VERSINFO[0]:-0}" -lt 3 ] || \
	{ [ "${BASH_VERSINFO[0]:-0}" -eq 3 ] && [ "${BASH_VERSINFO[1]:-0}" -lt 2 ]; }; then
	echo "pre-commit: bash >= 3.2 required (found ${BASH_VERSION:-unknown})" >&2
	exit 1
fi

# ── Temp directory for index-based linting ───────────────────────────────────
# Staged (index) blobs are checked out to a temp directory so linters read
# exactly what will be committed, not the working tree. See ADR-0015.
LINT_TMPDIR=$(mktemp -d)
trap 'rm -rf "$LINT_TMPDIR"' EXIT

# Check out a staged blob to the lint temp directory, preserving structure.
# Sets TMPF to the temp file path.
checkout_staged() {
	TMPF="$LINT_TMPDIR/$1"
	mkdir -p "$(dirname "$TMPF")"
	git show ":$1" > "$TMPF" 2>/dev/null || true
}

# ── PHP syntax check (staged files only) ─────────────────────────────────────
if command -v php > /dev/null 2>&1; then
	STAGED_PHP=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.php$' || true)
	if [ -n "$STAGED_PHP" ]; then
		echo "→ PHP syntax check"
		while IFS= read -r f; do
			[ -z "$f" ] && continue
			checkout_staged "$f"
			php -l "$TMPF" 2>&1 | sed "s|$LINT_TMPDIR/||g"
		done <<< "$STAGED_PHP"
	fi
fi

# ── php-cs-fixer (staged files only) ─────────────────────────────────────────
CS_FIXER=""
if [ -x vendor/bin/php-cs-fixer ]; then
	CS_FIXER=vendor/bin/php-cs-fixer
elif command -v php-cs-fixer > /dev/null 2>&1; then
	CS_FIXER=php-cs-fixer
fi
if [ -n "$CS_FIXER" ]; then
	# Only scan staged PHP files, excluding third-party directories
	STAGED_PHP=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.php$' | grep -vE '^(vendor/|node_modules/|aurora/)' || true)
	if [ -n "$STAGED_PHP" ]; then
		echo "→ php-cs-fixer"
		CS_CONFIG=""
		if [ -f .php-cs-fixer.dist.php ]; then
			CS_CONFIG=.php-cs-fixer.dist.php
		elif [ -f .php-cs-fixer.php ]; then
			CS_CONFIG=.php-cs-fixer.php
		fi
		# --path-mode=override: scan ONLY the explicitly-passed paths,
		# ignoring the Finder scope entirely (prevents node_modules leakage)
		PATHS=()
		while IFS= read -r p; do
			[ -n "$p" ] || continue
			checkout_staged "$p"
			PATHS+=("$TMPF")
		done <<< "$STAGED_PHP"
		if [ -n "$CS_CONFIG" ]; then
			"$CS_FIXER" fix --config="$CS_CONFIG" --dry-run --diff --path-mode=override "${PATHS[@]}" 2>&1 | sed "s|$LINT_TMPDIR/||g"
		else
			"$CS_FIXER" fix --dry-run --diff --path-mode=override "${PATHS[@]}" 2>&1 | sed "s|$LINT_TMPDIR/||g"
		fi
	fi
fi

# ── Stylelint (staged files only) ─────────────────────────────────────────────
STAGED_SCSS=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.scss$' || true)
if [ -n "$STAGED_SCSS" ] && [ -d node_modules/stylelint ]; then
	echo "→ Stylelint"
	SCSS_FAILED=0
	while IFS= read -r f; do
		[ -z "$f" ] && continue
		if ! git show ":$f" | npx stylelint --stdin-filename "$f"; then
			SCSS_FAILED=1
		fi
	done <<< "$STAGED_SCSS"
	[ "$SCSS_FAILED" -eq 0 ] || exit 1
fi

# ── ESLint (staged files only) ────────────────────────────────────────────────
STAGED_JS=$(git diff --cached --name-only --diff-filter=ACMR | grep '^cdn/js/.*\.js$' | grep -v '\.min\.js$' || true)
if [ -n "$STAGED_JS" ] && [ -d node_modules/eslint ]; then
	echo "→ ESLint"
	JS_FAILED=0
	while IFS= read -r f; do
		[ -z "$f" ] && continue
		if ! git show ":$f" | npx eslint --stdin --stdin-filename "$f" --no-error-on-unmatched-pattern; then
			JS_FAILED=1
		fi
	done <<< "$STAGED_JS"
	[ "$JS_FAILED" -eq 0 ] || exit 1
fi

# ── Shellcheck (staged shell scripts only) ──────────────────────────────────
STAGED_SH=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.sh$|^\.github/hooks/' || true)
if [ -n "$STAGED_SH" ]; then
	if command -v shellcheck > /dev/null 2>&1; then
		echo "→ Shellcheck"
		SH_TMPFILES=()
		while IFS= read -r f; do
			[ -z "$f" ] && continue
			checkout_staged "$f"
			SH_TMPFILES+=("$TMPF")
		done <<< "$STAGED_SH"
		shellcheck "${SH_TMPFILES[@]}" 2>&1 | sed "s|$LINT_TMPDIR/||g"
	else
		echo "⚠ shellcheck not installed — skipping (apt install shellcheck / brew install shellcheck)"
	fi
fi

# ── Gitleaks ──────────────────────────────────────────────────────────────────
if command -v gitleaks > /dev/null 2>&1; then
	echo "→ gitleaks"
	gitleaks git --pre-commit --staged --redact --verbose --no-color --max-target-megabytes 5
else
	echo "⚠ gitleaks not installed — skipping secrets scan (https://github.com/gitleaks/gitleaks/releases)"
fi

# ── RCS placeholder/foreign header check ──────────────────────────────────────
STAGED_SRC=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(php|js|scss|sh|ts)$' || true)
STAGED_SRC=$(echo "$STAGED_SRC" | grep -vE '^(vendor/|node_modules/|aurora/|cdn/css/|cdn/javascript/)' || true)
if [ -n "$STAGED_SRC" ]; then
	while IFS= read -r file; do
		[ -z "$file" ] && continue

		# shellcheck disable=SC2016  # $KYAULabs is a literal RCS marker
		HDR_LINE=$(git show ":$file" 2>/dev/null | head -10 | grep -F '$KYAULabs:' || true)
		[ -z "$HDR_LINE" ] && continue

		if echo "$HDR_LINE" | grep -qF 'creator@host'; then
			echo "✗ RCS placeholder in '$file': 'creator@host' — replace with real identity." >&2
			exit 1
		fi
		if echo "$HDR_LINE" | grep -qF 'YYYY/MM/DD'; then
			echo "✗ RCS placeholder in '$file': 'YYYY/MM/DD' — replace with real date." >&2
			exit 1
		fi
		if echo "$HDR_LINE" | grep -qF 'SEANBR~1'; then
			echo "✗ RCS foreign header in '$file': 'SEANBR~1' — replace with kyau@nova." >&2
			exit 1
		fi
	done <<< "$STAGED_SRC"
fi

# ── RCS header auto-add (strip-then-insert idempotent normalizer) ─────────────
STAGED_SRC=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(php|js|scss|sh|ts)$' || true)
STAGED_SRC=$(echo "$STAGED_SRC" | grep -vE '^(vendor/|node_modules/|aurora/|cdn/css/|cdn/javascript/)' || true)
if [ -n "$STAGED_SRC" ]; then
	CREATOR=$(git config user.email 2>/dev/null | cut -d@ -f1 || true)
	[ -z "$CREATOR" ] && CREATOR=$(git config user.name 2>/dev/null | tr -d ' ' 2>/dev/null || echo "unknown")
	HOSTNAME=$(hostname 2>/dev/null | tr '[:upper:]' '[:lower:]' || true)
	[ -z "$HOSTNAME" ] && HOSTNAME="unknown"
	DATESTR=$(date '+%Y/%m/%d %z')

	while IFS= read -r file; do
		[ -z "$file" ] && continue

		# Refuse to rewrite when the working tree has unstaged changes to this file.
		# The auto-add rebuilds the file from the staged blob; cp'ing that over the
		# working tree would silently destroy unstaged hunks (e.g. from `git add -p`).
		if ! git diff --quiet -- "$file"; then
			echo "✗ RCS auto-add blocked: '$file' has unstaged working-tree changes." >&2
			echo "  The auto-add rewrites the file from the staged blob, which would" >&2
			echo "  destroy unstaged hunks. To fix:" >&2
			echo "    - Stage the file fully:  git add $file" >&2
			echo "    - Or add the RCS header manually." >&2
			exit 1
		fi

		FNAME=$(basename "$file")
		EXT="${file##*.}"

		# Determine comment syntax and header line
		case "$EXT" in
			php)   HDR="# \$KYAULabs: $FNAME $CREATOR@$HOSTNAME $DATESTR Exp \$" ;;
			scss)  HDR="// \$KYAULabs: $FNAME $CREATOR@$HOSTNAME $DATESTR Exp \$" ;;
			js)    HDR="// \$KYAULabs: $FNAME $CREATOR@$HOSTNAME $DATESTR Exp \$" ;;
			sh)    HDR="# \$KYAULabs: $FNAME $CREATOR@$HOSTNAME $DATESTR Exp \$" ;;
			ts)    HDR="// \$KYAULabs: $FNAME $CREATOR@$HOSTNAME $DATESTR Exp \$" ;;
		esac

		# Determine vim modeline
		case "$EXT" in
			php)   ML="// vim: ft=php sts=4 sw=4 ts=4 et :" ;;
			scss)  ML="// vim: ft=scss sts=2 sw=2 ts=2 et :" ;;
			js)    ML="// vim: ft=javascript sts=4 sw=4 ts=4 noet :" ;;
			sh)    ML="# vim: ft=sh sts=4 sw=4 ts=4 et :" ;;
			ts)    ML="// vim: ft=typescript sts=4 sw=4 ts=4 et :" ;;
		esac

		# Extract staged content
		TMP=$(mktemp)
		git show ":$file" > "$TMP" 2>/dev/null || { rm -f "$TMP"; continue; }

		# Determine whether to append the vim modeline.
		# For PHP files, skip the modeline when the file ends outside PHP context
		# (after `?>` or in HTML output) — a `// vim:` line would render as
		# visible text in the browser.
		APPEND_ML=true
		if [ "$EXT" = "php" ]; then
			in_php=$(awk '
				BEGIN { in_php = 0 }
				{
					line = $0
					while (length(line) > 0) {
						if (!in_php) {
							if (match(line, /<\?(php|=)?/)) { in_php = 1; line = substr(line, RSTART + RLENGTH) }
							else { line = "" }
						} else {
							if (match(line, /\?>/)) { in_php = 0; line = substr(line, RSTART + 2) }
							else { line = "" }
						}
					}
				}
				END { print (in_php ? "1" : "0") }
			' "$TMP")
			[ "$in_php" = "1" ] || APPEND_ML=false
		fi

		# Strip ALL existing RCS headers and vim modelines into a cleaned copy.
		# This makes the normalizer idempotent: duplicates are collapsed to exactly
		# one of each below.
		CLEAN=$(mktemp)
		# shellcheck disable=SC2016  # $KYAULabs is a literal RCS marker
		grep -vE '^[[:space:]]*(#|//)[[:space:]]*(\$KYAULabs:|vim: ft=)' "$TMP" > "$CLEAN"

		# For PHP files, refuse to auto-add when line 1 is not <?php or <?=.
		# HTML-first templates and shebang scripts would land the header outside
		# PHP context, rendering it as page text. The user must add it manually
		# inside the first <?php block. Mirrors the modeline context gate above.
		if [ "$EXT" = "php" ]; then
			LINE1=$(head -1 "$CLEAN")
			if ! echo "$LINE1" | grep -qE '^<\?(php|=)'; then
				echo "✗ RCS auto-add blocked: '$file' does not start with <?php or <?=." >&2
				echo "  The header would land outside PHP context and render as page text." >&2
				echo "  To fix:" >&2
				echo "    - Add the RCS header manually inside the first <?php block." >&2
				rm -f "$TMP" "$CLEAN"
				exit 1
			fi
		fi

		# Build normalized file with exactly one canonical header + modeline
		{
			if [ "$EXT" = "php" ]; then
				# <?php on line 1
				head -1 "$CLEAN"
				echo ""

				# Emit declare(strict_types=1); exactly once if present anywhere
				declare_line=$(grep -n 'declare(strict_types=1);' "$CLEAN" | head -1 | cut -d: -f1 || true)
				if [ -n "$declare_line" ]; then
					sed -n "${declare_line}p" "$CLEAN"
				fi

				echo ""
				echo "$HDR"
				echo ""

				# Body: skip <?php and (if found) the declare line
				if [ -n "$declare_line" ]; then
					skip=$((declare_line - 1))
					tail -n +2 "$CLEAN" | awk -v s="$skip" 'NR==s{next} 1'
				else
					tail -n +2 "$CLEAN"
				fi
			elif [ "$EXT" = "sh" ]; then
				LINE1=$(head -1 "$CLEAN")
				if echo "$LINE1" | grep -q '^#!/'; then
					echo "$LINE1"
					echo "$HDR"
					echo ""
					tail -n +2 "$CLEAN"
				else
					echo "$HDR"
					echo ""
					cat "$CLEAN"
				fi
			else
				echo "$HDR"
				echo ""
				cat "$CLEAN"
			fi
			if $APPEND_ML; then
				echo ""
				echo "$ML"
			fi
		} > "$TMP.mod"

		# Only re-stage if the normalized content differs from the original staged blob
		if ! cmp -s "$TMP" "$TMP.mod"; then
			cp "$TMP.mod" "$file"
			git add "$file"
			echo "  + RCS header added: $file"
		fi

		rm -f "$TMP" "$CLEAN" "$TMP.mod"
	done <<< "$STAGED_SRC"
fi

echo "✓ pre-commit passed"

# vim: ft=sh sts=4 sw=4 ts=4 et :
