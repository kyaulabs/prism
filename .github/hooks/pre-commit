#!/usr/bin/env bash

set -euo pipefail

HOOK_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"
node "$HOOK_DIR/../scripts/check-staged-paths.js"
export PATH="$ROOT/node_modules/.bin:$ROOT/vendor/bin:$PATH"

# Scan the index, never unstaged changes. Do not print scanner findings.
if command -v gitleaks >/dev/null 2>&1; then
    echo '→ staged secret scan'
    if ! gitleaks git --pre-commit --staged --redact --no-color >/dev/null 2>&1; then
        echo 'Staged secret scan failed; inspect locally with redaction enabled.' >&2
        exit 1
    fi
else
    echo 'Warning: gitleaks unavailable; staged secret scan was not run.' >&2
fi

LINT_DIR=$(mktemp -d)
trap 'rm -rf -- "$LINT_DIR"' EXIT
PHP=()
SHELL=()
MARKDOWN=false
while IFS= read -r -d '' file; do
    case "$file" in
        vendor/*|node_modules/*|aurora/*|cdn/css/*|cdn/javascript/*) continue ;;
    esac
    case "$file" in
        *.md|*.php|*.sh|.github/hooks/*)
            mkdir -p -- "$LINT_DIR/$(dirname -- "$file")"
            git show ":$file" > "$LINT_DIR/$file"
            ;;
    esac
    case "$file" in
        *.md) MARKDOWN=true ;;
        *.php) PHP+=("$LINT_DIR/$file") ;;
        *.sh|.github/hooks/*) SHELL+=("$LINT_DIR/$file") ;;
        *.scss)
            git show ":$file" | stylelint --stdin-filename "$file"
            ;;
        cdn/js/*.js)
            git show ":$file" | eslint --stdin --stdin-filename "$file"
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMRT -z)

if "$MARKDOWN"; then
    echo '→ Markdown lint'
    markdownlint-cli2 --config "$ROOT/packages/prism-core/config/markdownlint-cli2.json" "$LINT_DIR/**/*.md"
fi
if [ "${#PHP[@]}" -gt 0 ]; then
    echo '→ PHP lint'
    for file in "${PHP[@]}"; do php -l "$file"; done
    CONFIG=()
    if [ -f .php-cs-fixer.dist.php ]; then
        CONFIG=(--config="$ROOT/.php-cs-fixer.dist.php")
    elif [ -f .php-cs-fixer.php ]; then
        CONFIG=(--config="$ROOT/.php-cs-fixer.php")
    fi
    php-cs-fixer fix "${CONFIG[@]}" --dry-run --diff --path-mode=override "${PHP[@]}"
fi
if [ "${#SHELL[@]}" -gt 0 ]; then
    echo '→ Shellcheck'
    shellcheck --severity=warning "${SHELL[@]}"
    if [ -f .github/scripts/check-script-executable-bits.sh ]; then
        bash .github/scripts/check-script-executable-bits.sh
    fi
fi

echo '✓ pre-commit passed'
