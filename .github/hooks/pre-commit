#!/usr/bin/env bash
# $KYAULabs: pre-commit,v 1.0.2 2026/07/04 00:00:00 -0700 kyau Exp $

set -euo pipefail

# ── PHP syntax check (staged files only) ─────────────────────────────────────
if command -v php > /dev/null 2>&1; then
	STAGED_PHP=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.php$' || true)
	if [ -n "$STAGED_PHP" ]; then
		echo "→ PHP syntax check"
		while IFS= read -r f; do
			php -l "$f"
		done <<< "$STAGED_PHP"
	fi
fi

# ── php-cs-fixer (staged files only) ─────────────────────────────────────────
CS_FIXER=""
if [ -x vendor/bin/php-cs-fixer ]; then
	CS_FIXER=vendor/bin/php-cs-fixer
elif command -v php-cs-fixer > /dev/null 2>&1; then
	CS_FIXER=php-cs-fixer
fi
if [ -n "$CS_FIXER" ]; then
	# Only scan staged PHP files, excluding third-party directories
	STAGED_PHP=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.php$' | grep -vE '^(vendor/|node_modules/|aurora/)' || true)
	if [ -n "$STAGED_PHP" ]; then
		echo "→ php-cs-fixer"
		CS_CONFIG=""
		if [ -f .php-cs-fixer.dist.php ]; then
			CS_CONFIG=.php-cs-fixer.dist.php
		elif [ -f .php-cs-fixer.php ]; then
			CS_CONFIG=.php-cs-fixer.php
		fi
		# --path-mode=override: scan ONLY the explicitly-passed paths,
		# ignoring the Finder scope entirely (prevents node_modules leakage)
		mapfile -t PATHS <<< "$STAGED_PHP"
		if [ -n "$CS_CONFIG" ]; then
			"$CS_FIXER" fix --config="$CS_CONFIG" --dry-run --diff --path-mode=override "${PATHS[@]}" 2>&1
		else
			"$CS_FIXER" fix --dry-run --diff --path-mode=override "${PATHS[@]}" 2>&1
		fi
	fi
fi

# ── Stylelint (staged files only) ─────────────────────────────────────────────
STAGED_SCSS=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.scss$' || true)
if [ -n "$STAGED_SCSS" ] && [ -d node_modules/stylelint ]; then
	echo "→ Stylelint"
	mapfile -t SCSS_FILES <<< "$STAGED_SCSS"
	npx stylelint "${SCSS_FILES[@]}"
fi

# ── ESLint (staged files only) ────────────────────────────────────────────────
STAGED_JS=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.js$' | grep -v '\.min\.js$' || true)
if [ -n "$STAGED_JS" ] && [ -d node_modules/eslint ]; then
	echo "→ ESLint"
	mapfile -t JS_FILES <<< "$STAGED_JS"
	npx eslint "${JS_FILES[@]}" --no-error-on-unmatched-pattern
fi

# ── Gitleaks ──────────────────────────────────────────────────────────────────
if command -v gitleaks > /dev/null 2>&1; then
	echo "→ gitleaks"
	# gitleaks v8+ uses 'detect'; v7 and earlier use 'protect'
	if gitleaks detect --help > /dev/null 2>&1; then
		GITLEAKS_CMD="detect"
	else
		GITLEAKS_CMD="protect"
	fi
	gitleaks "$GITLEAKS_CMD" --staged --redact --no-color --max-target-megabytes 5
fi

echo "✓ pre-commit passed"
