#!/usr/bin/env bash
# $KYAULabs: commit-msg kyau@aura.kyaulabs 2026/09/09 -0700 Exp $

set -euo pipefail

MSG_FILE="${1:?commit-msg: message file path required}"

if grep -qF '\n' "$MSG_FILE"; then
    printf '%s\n' "Commit message contains a literal '\\n'; use real line breaks in a message file." >&2
    exit 1
fi

if [ -x node_modules/.bin/commitlint ]; then
    exec node_modules/.bin/commitlint --edit "$MSG_FILE"
elif command -v commitlint >/dev/null 2>&1; then
    exec commitlint --edit "$MSG_FILE"
else
    echo "commitlint is unavailable; install the project's development dependencies." >&2
    exit 1
fi

# vim: ft=sh sts=4 sw=4 ts=4 et :
