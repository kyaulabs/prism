#!/usr/bin/env bash
# $KYAULabs: prepare-commit-msg kyau@nova 2026/07/30 -0700 Exp $

set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")
VALIDATOR="$REPO_ROOT/packages/prism-core/scripts/validate-branch-name.sh"
STATUS=0

# ── Protected branch check (ADR-0044) ─────────────────────────────────────
# Must run before the rebase early exit so that interactive rebase on
# main / develop is also blocked.  The only exception is the root commit
# on a freshly scaffolded repository with no remote tracking ref.
if [ -x "$VALIDATOR" ]; then
	set +e
	"$VALIDATOR"
	STATUS=$?
	set -e

	if [ "$STATUS" = "3" ]; then
		CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
		if ! git rev-parse --verify HEAD >/dev/null 2>&1 \
			&& ! git branch -r --list "*/$CURRENT_BRANCH" | grep -q .; then
			# Root exception: unborn HEAD + no matching remote ref.
			true
		else
			cat >&2 <<EOF
✗ Branch '$CURRENT_BRANCH' is protected; commit on a work branch instead.
  Run: bash packages/prism-core/scripts/new-branch.sh <type> <description>
EOF
			exit 1
		fi
	fi
fi

# Allow amend during interactive rebase (reword/edit operations re-create
# commits intentionally; blocking would prevent signing/correcting history).
if [ -d .git/rebase-merge ] || [ -d .git/rebase-apply ]; then
	exit 0
fi

COMMIT_SOURCE="${2:-}"
COMMIT_SHA="${3:-}"

# Block --amend of pushed commits.
#
# Git passes $2 = "commit" and $3 = "HEAD" (literal) for --amend without
# -m. However, -c HEAD and -C HEAD also pass $3 = "HEAD" — indistinguishable
# from --amend here. The hook errs on the side of safety and blocks both when
# HEAD is pushed. Workaround: use -c <sha> / -C <sha> with an explicit SHA.
#
# When -m is used with --amend, $2 is "message" — indistinguishable from a
# regular commit in this hook. The pre-push hook's non-fast-forward block
# is the safety net for that case.
if [ "$COMMIT_SOURCE" = "commit" ] && [ "$COMMIT_SHA" = "HEAD" ]; then
	# Check if the commit being amended has been pushed to any remote
	if git branch -r --contains HEAD 2>/dev/null | grep -q .; then
		cat >&2 <<EOF
✗ Cannot amend a commit that has been pushed to a remote.
  HEAD is reachable from a remote tracking branch.
  Use a regular commit ('git commit', not '--amend') to add changes.
  If you need to fix the commit message for an unpushed commit, amend
  is safe — but this commit has already been published.
EOF
		exit 1
	fi
fi

# ── Invalid branch name check (ADR-0028) ──────────────────────────────────
# Only reached for non-protected, non-root-exception branches after rebase
# early exit and amend-pushed checks have passed.
if [ -x "$VALIDATOR" ] && [ "$STATUS" -ne 0 ] && [ "$STATUS" -ne 3 ]; then
	cat >&2 <<EOF
✗ Commit rejected: branch name does not match Git Flow convention.
  See ADR-0028 and run: bash packages/prism-core/scripts/new-branch.sh <type> <description>
EOF
	exit 1
fi

exit 0

# vim: ft=sh sts=4 sw=4 ts=4 et :
