{
  "name": "prism",
  "private": true,
  "description": "Modular engineering skills and bounded extensions for Pi.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:cpp": "node --test tests/Node/cpp-native-verification.test.js",
    "test:host": "node --test --test-concurrency=2 tests/Node/pi-host*.test.ts tests/Node/pi-install.test.js",
    "test:node": "node --test --test-concurrency=2 tests/Node/*.test.js tests/Node/*.test.ts"
  },
  "overrides": {
    "minimatch@10": "11.0.3",
    "markdownlint": {"re2js": "2.8.7"},
    "micromark-extension-math": {
      "katex": "0.18.2"
    }
  },
  "devDependencies": {
    "@commitlint/config-conventional": "21.2.2",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@eslint/js": "10.0.1",
    "@mozilla/readability": "0.6.0",
    "@types/node": "^24",
    "@types/turndown": "5.0.6",
    "commitlint": "21.2.2",
    "eslint": "10.8.1",
    "js-yaml": "^5.5.0",
    "linkedom": "0.16.11",
    "markdownlint-cli2": "0.24.0",
    "playwright": "1.62.1",
    "sass": "1.102.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard-scss": "17.0.0",
    "tsx": "^4.23.12",
    "turndown": "7.2.4",
    "typebox": "1.3.27",
    "typescript": "^7.0.2",
    "uglify-js": "3.19.3"
  }
}
