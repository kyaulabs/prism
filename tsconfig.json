{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowJs": true,
        "checkJs": false,
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "skipLibCheck": true,
        "lib": ["ES2022", "DOM"],
        "types": ["node"]
    },
    "include": [
        "cdn/js/**/*.js",
        "packages/**/*.js",
        "packages/prism-core/extensions/safety/**/*.ts",
        "packages/prism-core/extensions/web-access/**/*.ts",
        "tests/Node/*.test.ts",
        "eslint.config.mjs",
        "commitlint.config.js"
    ],
    "exclude": [
        "node_modules",
        "vendor",
        "aurora",
        "cdn/javascript"
    ]
}
