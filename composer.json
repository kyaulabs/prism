{
	"name": "kyaulabs/cosmos",
	"description": "COSMOS — Private Services",
	"type": "project",
	"require": {
		"php": ">=8.5"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3",
		"pestphp/pest": "^3",
		"pestphp/pest-plugin-arch": "^3"
	},
	"autoload-dev": {
		"classmap": ["tests/"]
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"allow-plugins": {
			"pestphp/pest-plugin": true
		}
	}
}
