{
	"name": "kyaulabs/prism",
	"description": "Coding harness for pi that codifies disciplined, test-driven PHP development.",
	"type": "project",
	"license": "AGPL-3.0-only",
	"require": {
		"php": "^8.5",
		"ext-mbstring": "*"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3",
		"opis/json-schema": "^2.0",
		"pestphp/pest": "^4",
		"pestphp/pest-plugin-browser": "^4"
	},
	"autoload-dev": {
		"classmap": ["tests/"]
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"allow-plugins": {
			"pestphp/pest-plugin": true
		}
	}
}
