{
	"name": "kyaulabs/template",
	"description": "Template — Change This Description",
	"type": "project",
	"license": "AGPL-3.0-only",
	"require": {
		"php": "^8.5"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3",
		"opis/json-schema": "^2.0",
		"pestphp/pest": "^4",
		"pestphp/pest-plugin-browser": "^4"
	},
	"autoload": {
		"classmap": [".opencode/evals/bin/includes/"]
	},
	"autoload-dev": {
		"classmap": ["tests/"]
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"allow-plugins": {
			"pestphp/pest-plugin": true
		}
	}
}
