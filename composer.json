{
	"name": "kyaulabs/prism",
	"description": "Coding harness for pi that codifies disciplined, test-driven PHP development.",
	"type": "project",
	"license": "AGPL-3.0-only",
	"require": {
		"php": "^8.5",
		"ext-mbstring": "*"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "3.95.18",
		"opis/json-schema": "^2.0",
		"pestphp/pest": "5.1.1",
		"pestphp/pest-plugin-browser": "5.0.1"
	},
	"autoload-dev": {
		"classmap": ["tests/"]
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"allow-plugins": {
			"pestphp/pest-plugin": true
		}
	}
}
